# North Garden local provider configuration
# Copy to .env, fill only the credentials you choose to use, and never commit .env.
# Blank values keep every paid adapter disabled. The adapters load this file only
# when executed; --execute remains required for any provider call.

# Required shared explicit spending authority for the prepared API bakeoff.
# Leave blank until you intentionally authorize a cap. Prepared adapters refuse > 20.
NORTH_GARDEN_APPROVED_BAKEOFF_CAP_USD=

# Currently executable fictional-control bakeoff adapters.
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alternative to GEMINI_API_KEY.
GOOGLE_API_KEY=
XAI_API_KEY=
BFL_API_KEY=

# BFL only: public HTTPS locations for the two original non-sensitive geometry
# controls. The adapter downloads and hash-verifies each before any BFL request.
NORTH_GARDEN_BFL_G07A_CONTROL_URL=
NORTH_GARDEN_BFL_G07A_NOCHANGE_CONTROL_URL=

# Managed-GPU or model-acquisition candidates. No current adapter automatically
# uses these; leave blank unless a later approved profile specifically needs one.
RUNPOD_API_KEY=
VAST_API_KEY=
LAMBDA_API_KEY=
HUGGINGFACE_HUB_TOKEN=
CIVITAI_API_TOKEN=

# Prospective frontier API candidates, not currently wired into the G07 runner.
REPLICATE_API_TOKEN=
FAL_KEY=
TOGETHER_API_KEY=
