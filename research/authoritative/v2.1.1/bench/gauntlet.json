  "stage_b_full": {
   "purpose": "finalists only",
   "case_ids": "all render_cases",
   "seeds_per_case": 3
  },
  "freeze_rule": "Never edit a case to make a candidate look better. Retire and re-ID, or publish a new schema version."
 },
 "counting_rules": {
  "renderer_generations_are": "render_cases x seeds. QA controls and injections are DERIVED and are NOT renderer generations.",
  "qa_controls_are": "re-renders of an existing parent case at the same seeds; they measure fabricated-error rate only",
  "qa_injections_are": "mutations of approved outputs; they measure detection recall by error class and must NOT contaminate renderer scoring"
 }
}