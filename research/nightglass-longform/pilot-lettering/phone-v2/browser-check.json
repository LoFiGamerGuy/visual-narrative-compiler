      "balloons": [
        {
          "panel": "NG02",
          "speaker": "Sera",
          "text": "Intake is beyond the gate. Deliver before closing. Then we discuss upper routes.",
          "font": "16px",
          "width": 328,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG02",
          "speaker": "Aren",
          "text": "I practiced looking unimpressed. How am I doing?",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "NG04",
          "speaker": "Pell",
          "text": "The brake is gone!",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG04",
          "speaker": "Sera",
          "text": "SeraAren. That gate will not wait.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "NG05",
          "speaker": "Aren",
          "text": "Neither will he.",
          "font": "16px",
          "width": 177,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG05",
          "speaker": "Sera",
          "text": "You understand what you are giving up?",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG06",
          "speaker": "Aren",
          "text": "It pulls me. Not the whole car.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "NG06",
          "speaker": "Aren",
          "text": "Try not to be a heavy man, Pell.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "NG07",
          "speaker": "Pell",
          "text": "PellI have been meaning to eat less.",
          "font": "16px",
          "width": 285,
          "height": 77,
          "inside": true
        },
        {
          "panel": "NG07",
          "speaker": "Aren",
          "text": "ArenExcellent. Start immediately.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "NG09",
          "speaker": "Aren",
          "text": "Wrong delivery.",
          "font": "16px",
          "width": 164,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG10",
          "speaker": "Aren",
          "text": "Pell. Unclip. Now.",
          "font": "16px",
          "width": 281,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG11",
          "speaker": "Pell",
          "text": "Your arm\u2014",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG11",
          "speaker": "Aren",
          "text": "Complain after we land.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG13",
          "speaker": "Pell",
          "text": "I owe you a delivery.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG13",
          "speaker": "Aren",
          "text": "Make it one that counts.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "NG14",
          "speaker": "Sera",
          "text": "No stamp. I cannot change that.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG14",
          "speaker": "Aren",
          "text": "I know. That does not make me less angry.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG15",
          "speaker": "Pell",
          "text": "This is addressed to you. From Lower District.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG15",
          "speaker": "Aren",
          "text": "That district has been empty for twenty years.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "NG16",
          "speaker": "Aren",
          "text": "Apparently someone forgot to stop writing.",
          "font": "16px",
          "width": 281,
          "height": 61,
          "inside": true
        }
      ]
    },
