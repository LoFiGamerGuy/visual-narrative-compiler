      "balloons": [
        {
          "panel": "RC02",
          "speaker": "Vexa",
          "text": "Clear the bridge. Earn the key.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "RC02",
          "speaker": "Ren",
          "text": "You make it sound as if nobody has tried.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC03",
          "speaker": "Vexa",
          "text": "Borrowed Counter? Did you read the terms?",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "RC03",
          "speaker": "Ren",
          "text": "I read the part where it hits back.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "RC05",
          "speaker": "Ren",
          "text": "Mine.",
          "font": "16px",
          "width": 98,
          "height": 42,
          "inside": true
        },
        {
          "panel": "RC06",
          "speaker": "Ren",
          "text": "That was considerably more than advertised.",
          "font": "16px",
          "width": 281,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC07",
          "speaker": "Vexa",
          "text": "One hit. Do not ask it for two.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "RC07",
          "speaker": "Ren",
          "text": "I only need one good answer.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "RC09",
          "speaker": "Ren",
          "text": "Come collect.",
          "font": "16px",
          "width": 140,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC11",
          "speaker": "Vexa",
          "text": "VexaBridge clear.",
          "font": "16px",
          "width": 195,
          "height": 58,
          "inside": true
        },
        {
          "panel": "RC12",
          "speaker": "Ren",
          "text": "You could try sounding impressed.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "RC12",
          "speaker": "Vexa",
          "text": "I am. That is why I am worried.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC14",
          "speaker": "Ren",
          "text": "Temporary?",
          "font": "16px",
          "width": 177,
          "height": 42,
          "inside": true
        },
        {
          "panel": "RC14",
          "speaker": "Vexa",
          "text": "The numbness. The debt has other ideas.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "RC15",
          "speaker": "Vexa",
          "text": "Those gauntlets did not invent that force.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC15",
          "speaker": "Ren",
          "text": "Then I should probably meet the owner.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "RC16",
