      "balloons": [
        {
          "panel": "FL02",
          "speaker": "Ada",
          "text": "My brother\u2019s coat came back. He did not.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL02",
          "speaker": "Corin",
          "text": "Coats are poor witnesses. Let us find a better one.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL03",
          "speaker": "Ada",
          "text": "He never used the ladder.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL03",
          "speaker": "Corin",
          "text": "You said that. I should have listened.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL04",
          "speaker": "Corin",
          "text": "Do not move the water.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL04",
          "speaker": "Ada",
          "text": "I was not planning to.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL06",
          "speaker": "Ada",
          "text": "What did you see?",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL06",
          "speaker": "Corin",
          "text": "Your brother opened something. Something noticed.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL08",
          "speaker": "Corin",
          "text": "You can reach.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL08",
          "speaker": "Corin",
          "text": "You cannot climb. Good distinction.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL09",
          "speaker": "Ada",
          "text": "Lio! That was his footprint.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL09",
          "speaker": "Corin",
          "text": "Stay here. I have already been wrong once today.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL11",
          "speaker": "Corin",
          "text": "Ada. Take his shoulders.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL11",
          "speaker": "Ada",
          "text": "AdaThen keep that mouth open.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "FL12",
          "speaker": "Corin",
          "text": "Keep pulling.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL14",
          "speaker": "Lio",
          "text": "They told me the sluice was empty.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL14",
          "speaker": "Corin",
          "text": "Who is they?",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "FL15",
          "speaker": "Lio",
          "text": "LioFlood Authority. Night shift.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "FL15",
          "speaker": "Corin",
          "text": "Of course. They used to pay me to call this weather.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "FL16",
          "speaker": "Corin",
          "text": "Now I send them an invoice.",
          "font": "16px",
          "width": 281,
          "height": 42,
