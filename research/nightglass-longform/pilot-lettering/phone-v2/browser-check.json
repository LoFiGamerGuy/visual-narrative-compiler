      "balloons": [
        {
          "panel": "ST02",
          "speaker": "Mara",
          "text": "Bring back my signal bell. I will find you a seat.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST02",
          "speaker": "Tavi",
          "text": "A seat? I was negotiating a window.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST03",
          "speaker": "Tavi",
          "text": "You do not even have luggage. What do you need a bell for?",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST04",
          "speaker": "Tavi",
          "text": "Both feet down. Then we can discuss it loudly.",
          "font": "16px",
          "width": 281,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST06",
          "speaker": "Tavi",
          "text": "Lost my footing. Lost my charge.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST06",
          "speaker": "Tavi",
          "text": "That was a rude amount of discussion.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "ST07",
          "speaker": "Tavi",
          "text": "Oh. You hate the noise.",
          "font": "16px",
          "width": 281,
          "height": 42,
          "inside": true
        },
        {
          "panel": "ST09",
          "speaker": "Tavi",
          "text": "Your ears. My ride.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST09",
          "speaker": "Tavi",
          "text": "Neither of us has to be miserable. Deal?",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "ST11",
          "speaker": "Tavi",
          "text": "Small breath. Small sound.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST11",
          "speaker": "Tavi",
          "text": "I can learn. Occasionally.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST12",
          "speaker": "Tavi",
          "text": "See? A civil conversation.",
          "font": "16px",
          "width": 281,
          "height": 42,
          "inside": true
        },
        {
          "panel": "ST13",
          "speaker": "Mara",
          "text": "That is not one of our seats.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST13",
          "speaker": "Tavi",
          "text": "It has a better window.",
          "font": "16px",
          "width": 177,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST14",
          "speaker": "Tavi",
          "text": "Tell nobody about this part.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "ST14",
          "speaker": "Mara",
          "text": "I will need more cloth for that bargain.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST15",
          "speaker": "Mara",
          "text": "Follow us to the first skyport. Then choose your road.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "ST15",
          "speaker": "Tavi",
          "text": "TaviI like the sound of that. Quietly.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "ST16",
          "speaker": "Tavi",
          "text": "Next stop: somewhere with lunch.",
          "font": "16px",
          "width": 281,
          "height": 61,
          "inside": true
        }
      ]
    },
