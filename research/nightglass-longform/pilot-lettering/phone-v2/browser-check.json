      "balloons": [
        {
          "panel": "BP02",
          "speaker": "Voice",
          "text": "Little moth. Come inside.",
          "font": "16px",
          "width": 285,
          "height": 44,
          "inside": true
        },
        {
          "panel": "BP02",
          "speaker": "Ilyra",
          "text": "Oren?",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP03",
          "speaker": "Ilyra",
          "text": "You promised never to call me that.",
          "font": "16px",
          "width": 177,
          "height": 81,
          "inside": true
        },
        {
          "panel": "BP03",
          "speaker": "Voice",
          "text": "Little moth. Come inside.",
          "font": "16px",
          "width": 177,
          "height": 63,
          "inside": true
        },
        {
          "panel": "BP04",
          "speaker": "Neris",
          "text": "Do not answer it.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP04",
          "speaker": "Ilyra",
          "text": "A little late for that.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP05",
          "speaker": "Neris",
          "text": "NerisIt borrowed my husband first.",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "BP05",
          "speaker": "Ilyra",
          "text": "Then it has had practice.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP07",
          "speaker": "Voice",
          "text": "Little moth. Come inside.",
          "font": "16px",
          "width": 285,
          "height": 44,
          "inside": true
        },
        {
          "panel": "BP07",
          "speaker": "Ilyra",
          "text": "Tell me what you called me after the fire.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP08",
          "speaker": "Voice",
          "text": "Little moth. Come inside.",
          "font": "16px",
          "width": 285,
          "height": 44,
          "inside": true
        },
        {
          "panel": "BP09",
          "speaker": "Ilyra",
          "text": "I came for a person.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP09",
          "speaker": "Ilyra",
          "text": "You only brought me a voice.",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP11",
          "speaker": "Neris",
          "text": "NerisMind the head!",
          "font": "16px",
          "width": 285,
          "height": 58,
          "inside": true
        },
        {
          "panel": "BP12",
          "speaker": "Ilyra",
          "text": "The root is clear. Come through.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP12",
          "speaker": "Neris",
          "text": "I thought I would never see this side.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP14",
          "speaker": "Neris",
          "text": "The nursery sent that with yesterday\u2019s planting.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP14",
          "speaker": "Ilyra",
          "text": "This was on his coat when he vanished.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP15",
          "speaker": "Neris",
          "text": "Does that mean he is alive?",
          "font": "16px",
          "width": 285,
          "height": 42,
          "inside": true
        },
        {
          "panel": "BP15",
          "speaker": "Ilyra",
          "text": "It means someone knows more than a flower.",
          "font": "16px",
          "width": 285,
          "height": 61,
          "inside": true
        },
        {
          "panel": "BP16",
          "speaker": "Ilyra",
          "text": "We start with the nursery.",
          "font": "16px",
          "width": 281,
          "height": 42,
          "inside": true
        }
      ]
    },
