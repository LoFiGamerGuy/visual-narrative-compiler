{
  "snapshot_sha256": "5ac1f9fa1020f548af8f699ed6a0a7773a8ebacf9a90d2b255c5363de09fe889",
  "script_sha256": "3a83846acb3663ea1f6d05bb2426531276a02c9ac326364327347ae4e697ef50",
  "available": 40,
  "total": 40,
  "previous266_and_comparisons_exact": true,
  "all_old_overrides_and_selected_records_exact": true,
  "prior_chapter7_records_exact_count": 36,
  "source_copy_records": [
    {
      "id": "N7-01",
      "sha256": "7939fcbc2e56061e70ef5da9e9d0ec110ff1f04a35f09a13dcebb991f2409758",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Two mornings later. Ninth round complete."
        },
        {
          "speaker": "Ossa",
          "text": "Give Kiva my morning."
        }
      ]
    },
    {
      "id": "N7-02",
      "sha256": "d1564638c533b44c5501c0dc2510d16e393cac27e5197b1e849a7df71ea225fd",
      "copy": []
    },
    {
      "id": "N7-03",
      "sha256": "08a8d928434745ac7303f377c9a867da98e1662a512033c3b9c40eafbd230207",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "Daro brought the packing stock up. His cart is below."
        },
        {
          "speaker": "Daro",
          "text": "I would rather earn something on the way back."
        }
      ]
    },
    {
      "id": "N7-04",
      "sha256": "b1359fec6f1f366f21fc9ef0a171aed9014a2cc10fc73ad7a7b64d1db82c4988",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "This set is Rusk’s. The buyer’s is still in the jig."
        }
      ]
    },
    {
      "id": "N7-05",
      "sha256": "b312c1a06b21531512187d3fcef99b182bd823c7fa85cd841e9a5c3d32c4c441",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I thought I was taking it to Rusk."
        },
        {
          "speaker": "Kiva",
          "text": "You are collecting it for me. We have not agreed the rest yet."
        }
      ]
    },
    {
      "id": "N7-06",
      "sha256": "bab1c9b279c5001b1c20a7adb85d22b89dd780e7add0ee1ad88e53df50d0d031",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Rusk asked for the rear yard today. His long frame is in the front aisle."
        },
        {
          "speaker": "Daro",
          "text": "You bring the box to the landing. I take the cart leg; her board comes back with you."
        }
      ]
    },
    {
      "id": "N7-07",
      "sha256": "ea404e46b68c6c8d7aaeb7edf54d2484d34418ef858757414f762f5685e0256e",
      "copy": [
        {
          "speaker": "Daro",
          "text": "The cart cannot climb these steps. From that landing, the ramp goes round to his yard."
        }
      ]
    },
    {
      "id": "N7-08",
      "sha256": "08e8413566fae664918a2b22a8e3d38ec133316ffad440baadee4e4dd3810c4d",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "Aren collects. Daro may carry it from the landing to Rusk."
        },
        {
          "speaker": "Kiva",
          "text": "If he cannot receive it, bring it back. No doorstep drop."
        }
      ]
    },
    {
      "id": "N7-09",
      "sha256": "f674f875eda620d34ca0e4badcb2e6f37f0bb2ae89a44408caa704b094dcb1c3",
      "copy": [
        {
          "speaker": "Daro",
          "text": "My usual cart share, when Rusk’s receipt comes back."
        },
        {
          "speaker": "Kiva",
          "text": "The rest of the collection fee is yours, Aren. Agreed?"
        },
        {
          "speaker": "Aren",
          "text": "Agreed."
        }
      ]
    },
    {
      "id": "N7-10",
      "sha256": "9ca50f9d9c9c760e3a4ddc73d4998cd45756c9f3ecd8e41b54981bc46b635c30",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "His slip comes back. The hinges stay with him."
        }
      ]
    },
    {
      "id": "N7-11",
      "sha256": "08e9ae013647d5c3cddec33348876d2b17ca6eae4448460502332908763f237b",
      "copy": [
        {
          "speaker": "Aren",
          "text": "One box to Rusk. The board back here."
        }
      ]
    },
    {
      "id": "N7-12",
      "sha256": "ee29d00bdba79f02e255ba6b4e16e85fbfe3d5b3bbdee123ef09be53b5cbdb62",
      "copy": []
    },
    {
      "id": "N7-13",
      "sha256": "cd89a8bedd40a7f9fd1545c80d782ccae1090cb61acc5faced2d0dbc95ef87a8",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Use the outside turn. The inside catches the board."
        }
      ]
    },
    {
      "id": "N7-14",
      "sha256": "23a51b56e07e5a994fb1f446b8a3d3bd5454b36b71c96d1719236ce201fbeddd",
      "copy": []
    },
    {
      "id": "N7-15",
      "sha256": "205ae0e88611e3e386218075b5eab0b8bffb12c788d0115beb26af9beb29c7a3",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Here. No tilt over the wheel."
        }
      ]
    },
    {
      "id": "N7-16",
      "sha256": "534e3698e3e0b0f60312bcdb566712b02f39c7e9cd878df0d93bd8261660217d",
      "copy": [
        {
          "speaker": "Aren",
          "text": "It is yours to carry now."
        },
        {
          "speaker": "Daro",
          "text": "To Rusk. Or back to Kiva."
        }
      ]
    },
    {
      "id": "N7-17",
      "sha256": "48317ff7bc939dd61e382e26a7594d9a7facff7c1756fa4daa84b8ac8478781a",
      "copy": []
    },
    {
      "id": "N7-18",
      "sha256": "213a2d86e0dd59f01f55767c1f295e5e23e0bb914c63b97e22c4dbb1913b1071",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I could come down with you."
        }
      ]
    },
    {
      "id": "N7-19",
      "sha256": "d7d21e324aa3c26d1a4fb57813a35d3323836be1bd3b412e6805072c6c527aea",
      "copy": [
        {
          "speaker": "Daro",
          "text": "You can. It will still be my load."
        }
      ]
    },
    {
      "id": "N7-20",
      "sha256": "555a20c935730db3a8ceab704e289099ff6704162f8a135c8bef3731c5c08047",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I will take this back."
        }
      ]
    },
    {
      "id": "N7-21",
      "sha256": "1f90c22c5722f681e595fb1e487a69052a5023f004cd444c6cd1f068e1863afd",
      "copy": []
    },
    {
      "id": "N7-22",
      "sha256": "1b5e572c9288f70b74ad6736a0db01d347418a8370089f4dd5b9d3829d30e41a",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Rusk. Kiva’s set."
        }
      ]
    },
    {
      "id": "N7-23",
      "sha256": "f318d75387014b0122c60edda90e80cf874e7f4f6791f193bd29c371383b3fa2",
      "copy": [
        {
          "speaker": "Rusk",
          "text": "Put it here, out of the shavings."
        }
      ]
    },
    {
      "id": "N7-24",
      "sha256": "51dffa7364fbb5354de73068f0822d675fa1141597153b469988516b25d40f28",
      "copy": [
        {
          "speaker": "Rusk",
          "text": "Good. I can fit these when the frame is out."
        }
      ]
    },
    {
      "id": "N7-25",
      "sha256": "798e73fd5338b06f9830eb39c5607e23729a39c86ba9c94d7180c1390cb0a6d6",
      "copy": [
        {
          "speaker": "Rusk",
          "text": "Tell her I have the set."
        }
      ]
    },
    {
      "id": "N7-26",
      "sha256": "7ed6484ad3ea5210c952c8518ea2b73d1202a62630ebd31635be2bcf4f7163de",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "That is the piece I was waiting for."
        }
      ]
    },
    {
      "id": "N7-27",
      "sha256": "c5b831644165f43933ba1c983bddebd97830bcaa3dac7caeb3bd8b7f88deff30",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I keep thinking I should be there."
        }
      ]
    },
    {
      "id": "N7-28",
      "sha256": "e1a905ef9e9557b1fa817861b103de25e615fca2d6a4b7a12a3852dbeddb5f56",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "You brought this back. I can keep working."
        },
        {
          "speaker": "Kiva",
          "text": "Let him finish his part."
        }
      ]
    },
    {
      "id": "N7-29",
      "sha256": "dc60b0a8b1a29d682fd99f25ce220a9764224a6cc06b1b4484d3508e5e776c09",
      "copy": []
    },
    {
      "id": "N7-30",
      "sha256": "99c7aeb35f389be8cdc3e3bf3a1757a815e0c76b4df8dcf9623a9cdda6c51811",
      "copy": []
    },
    {
      "id": "N7-31",
      "sha256": "660f48e12204c81a9900a6fdfc803f2d8a5ff7ffd117c9b1e15160813fb80f21",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Rusk has the set."
        },
        {
          "speaker": "Kiva",
          "text": "Thank you. Both of you."
        }
      ]
    },
    {
      "id": "N7-32",
      "sha256": "827f172a02cea3149c1b13285822689eb0e1187a0cd4ba7c30a3a28f291dba05",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "Your cart share."
        }
      ]
    },
    {
      "id": "N7-33",
      "sha256": "a256437b07cff9169e89e81ca007994e73734503909dab315f98fabd9af4f62e",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "And the collection."
        }
      ]
    },
    {
      "id": "N7-34",
      "sha256": "ac7246c203e238ef841cd1d2379141dc7ff97a829420bff66d19f2aed0c1f744",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Next time, I will ask you before I plan the stairs."
        },
        {
          "speaker": "Daro",
          "text": "Tell me the landing. I will tell you when I can be there."
        }
      ]
    },
    {
      "id": "N7-35",
      "sha256": "e23f2e85f11110d4fe401a6fee9d8eb773de6aaaf98a62bea6188bd335dc397e",
      "copy": [
        {
          "speaker": "Daro",
          "text": "East washhouse asked for first-bell collection next market day."
        }
      ]
    },
    {
      "id": "N7-36",
      "sha256": "4e572b5ec7278aaa7c78b0686e3255ae6d5a864cf118a40f8a2c4664ec6c762a",
      "copy": [
        {
          "speaker": "Aren",
          "text": "That is my morning round."
        },
        {
          "speaker": "Daro",
          "text": "And I have not walked the collection door they marked."
        }
      ]
    },
    {
      "id": "N7-37",
      "sha256": "82f77ab72d64393c51400e27c39d67a918d438a62b53d34e7ac1ed1dbe2a0a3a",
      "copy": [
        {
          "speaker": "Aren",
          "text": "We speak to the person handing goods over before either of us promises."
        },
        {
          "speaker": "Daro",
          "text": "Tomorrow after your round. Meet here."
        }
      ]
    },
    {
      "id": "N7-38",
      "sha256": "4b48bd35fc52b612a58d5bf005d955f7541a007f4928e56d5060734073807aaf",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Later, in his own room."
        },
        {
          "speaker": "Sera",
          "text": "How was the collection?"
        }
      ]
    },
    {
      "id": "N7-39",
      "sha256": "7b5fd85fda20449eeffbe2fcc8848b55a3f6070f44eab6c13c4fa2a7c4509163",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I only carried it halfway."
        },
        {
          "speaker": "Sera",
          "text": "Did it arrive?"
        },
        {
          "speaker": "Aren",
          "text": "Yes."
        }
      ]
    },
    {
      "id": "N7-40",
      "sha256": "ec4c18b480ea9a44e1e4cb2826c3a9d85d80a96703d472df32147e320c8007b3",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Will you walk to the east washhouse with us after tomorrow’s round?"
        },
        {
          "speaker": "Sera",
          "text": "Yes. With the person handing the goods over."
        }
      ]
    }
  ],
