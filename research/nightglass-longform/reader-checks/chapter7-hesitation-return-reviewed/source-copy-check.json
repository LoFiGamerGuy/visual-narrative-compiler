  "source_copy_records": [
    {
      "id": "N7-01",
      "sha256": "7939fcbc2e56061e70ef5da9e9d0ec110ff1f04a35f09a13dcebb991f2409758",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Two mornings later. Ninth round complete."
        },
        {
          "speaker": "Ossa",
          "text": "Give Kiva my morning."
        }
      ]
    },
    {
      "id": "N7-02",
      "sha256": "d1564638c533b44c5501c0dc2510d16e393cac27e5197b1e849a7df71ea225fd",
      "copy": []
    },
    {
      "id": "N7-03",
      "sha256": "08a8d928434745ac7303f377c9a867da98e1662a512033c3b9c40eafbd230207",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "Daro brought the packing stock up. His cart is below."
        },
        {
          "speaker": "Daro",
          "text": "I would rather earn something on the way back."
        }
      ]
    },
    {
      "id": "N7-04",
      "sha256": "b1359fec6f1f366f21fc9ef0a171aed9014a2cc10fc73ad7a7b64d1db82c4988",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "This set is Rusk’s. The buyer’s is still in the jig."
        }
      ]
    },
    {
      "id": "N7-05",
      "sha256": "b312c1a06b21531512187d3fcef99b182bd823c7fa85cd841e9a5c3d32c4c441",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I thought I was taking it to Rusk."
        },
        {
          "speaker": "Kiva",
          "text": "You are collecting it for me. We have not agreed the rest yet."
        }
      ]
    },
    {
      "id": "N7-06",
      "sha256": "bab1c9b279c5001b1c20a7adb85d22b89dd780e7add0ee1ad88e53df50d0d031",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Rusk asked for the rear yard today. His long frame is in the front aisle."
        },
        {
          "speaker": "Daro",
          "text": "You bring the box to the landing. I take the cart leg; her board comes back with you."
        }
      ]
    },
    {
      "id": "N7-07",
      "sha256": "ea404e46b68c6c8d7aaeb7edf54d2484d34418ef858757414f762f5685e0256e",
      "copy": [
        {
          "speaker": "Daro",
          "text": "The cart cannot climb these steps. From that landing, the ramp goes round to his yard."
        }
      ]
    },
    {
      "id": "N7-08",
      "sha256": "08e8413566fae664918a2b22a8e3d38ec133316ffad440baadee4e4dd3810c4d",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "Aren collects. Daro may carry it from the landing to Rusk."
        },
        {
          "speaker": "Kiva",
          "text": "If he cannot receive it, bring it back. No doorstep drop."
        }
      ]
    },
    {
      "id": "N7-09",
      "sha256": "f674f875eda620d34ca0e4badcb2e6f37f0bb2ae89a44408caa704b094dcb1c3",
      "copy": [
        {
          "speaker": "Daro",
          "text": "My usual cart share, when Rusk’s receipt comes back."
        },
        {
          "speaker": "Kiva",
          "text": "The rest of the collection fee is yours, Aren. Agreed?"
        },
        {
          "speaker": "Aren",
          "text": "Agreed."
        }
      ]
    },
    {
      "id": "N7-10",
      "sha256": "9ca50f9d9c9c760e3a4ddc73d4998cd45756c9f3ecd8e41b54981bc46b635c30",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "His slip comes back. The hinges stay with him."
        }
      ]
    },
    {
      "id": "N7-11",
      "sha256": "08e9ae013647d5c3cddec33348876d2b17ca6eae4448460502332908763f237b",
      "copy": [
        {
          "speaker": "Aren",
          "text": "One box to Rusk. The board back here."
        }
      ]
    },
    {
      "id": "N7-12",
      "sha256": "ee29d00bdba79f02e255ba6b4e16e85fbfe3d5b3bbdee123ef09be53b5cbdb62",
      "copy": []
    },
    {
      "id": "N7-13",
      "sha256": "cd89a8bedd40a7f9fd1545c80d782ccae1090cb61acc5faced2d0dbc95ef87a8",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Use the outside turn. The inside catches the board."
        }
      ]
    },
    {
      "id": "N7-14",
      "sha256": "23a51b56e07e5a994fb1f446b8a3d3bd5454b36b71c96d1719236ce201fbeddd",
      "copy": []
    },
    {
      "id": "N7-15",
      "sha256": "205ae0e88611e3e386218075b5eab0b8bffb12c788d0115beb26af9beb29c7a3",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Here. No tilt over the wheel."
        }
      ]
    },
    {
      "id": "N7-16",
      "sha256": "534e3698e3e0b0f60312bcdb566712b02f39c7e9cd878df0d93bd8261660217d",
      "copy": [
        {
          "speaker": "Aren",
          "text": "It is yours to carry now."
        },
        {
          "speaker": "Daro",
          "text": "To Rusk. Or back to Kiva."
        }
      ]
    },
    {
      "id": "N7-17",
      "sha256": "48317ff7bc939dd61e382e26a7594d9a7facff7c1756fa4daa84b8ac8478781a",
      "copy": []
    },
    {
      "id": "N7-18",
      "sha256": "213a2d86e0dd59f01f55767c1f295e5e23e0bb914c63b97e22c4dbb1913b1071",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I could come down with you."
        }
      ]
    },
    {
      "id": "N7-19",
      "sha256": "d7d21e324aa3c26d1a4fb57813a35d3323836be1bd3b412e6805072c6c527aea",
      "copy": [
        {
          "speaker": "Daro",
          "text": "You can. It will still be my load."
        }
      ]
    },
    {
      "id": "N7-26",
      "sha256": "7ed6484ad3ea5210c952c8518ea2b73d1202a62630ebd31635be2bcf4f7163de",
      "copy": [
        {
          "speaker": "Kiva",
          "text": "That is the piece I was waiting for."
        }
      ]
    },
    {
      "id": "N7-27",
      "sha256": "c5b831644165f43933ba1c983bddebd97830bcaa3dac7caeb3bd8b7f88deff30",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I keep thinking I should be there."
        }
      ]
    },
    {
      "id": "N7-38",
      "sha256": "4b48bd35fc52b612a58d5bf005d955f7541a007f4928e56d5060734073807aaf",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Later, in his own room."
        },
        {
          "speaker": "Sera",
          "text": "How was the collection?"
        }
      ]
    },
    {
      "id": "N7-39",
      "sha256": "7b5fd85fda20449eeffbe2fcc8848b55a3f6070f44eab6c13c4fa2a7c4509163",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I only carried it halfway."
        },
        {
          "speaker": "Sera",
          "text": "Did it arrive?"
        },
        {
          "speaker": "Aren",
          "text": "Yes."
        }
      ]
    },
    {
      "id": "N7-40",
      "sha256": "ec4c18b480ea9a44e1e4cb2826c3a9d85d80a96703d472df32147e320c8007b3",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Will you walk to the east washhouse with us after tomorrow’s round?"
        },
        {
          "speaker": "Sera",
          "text": "Yes. With the person handing the goods over."
        }
      ]
    }
  ],
