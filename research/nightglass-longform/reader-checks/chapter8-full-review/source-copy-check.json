{
  "snapshot_sha256": "92a897878d554d112ca9cb597cf25330f13f793ef0ca8851a7ff0b488b3fd1e4",
  "script_sha256": "0a3d3a441efd5017d84347c2e5849c514f313a00f6bfdb0df898cd93ea1982fc",
  "available": 45,
  "total": 45,
  "previous306_and_comparisons_exact": true,
  "all_old_overrides_and_selected_records_exact": true,
  "prior_chapter8_records_exact_count": 43,
  "source_copy_records": [
    {
      "id": "N8-01",
      "sha256": "7939fcbc2e56061e70ef5da9e9d0ec110ff1f04a35f09a13dcebb991f2409758",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Next morning. Tenth round complete."
        },
        {
          "speaker": "Ossa",
          "text": "They will still be there when you have put your money away."
        }
      ]
    },
    {
      "id": "N8-02",
      "sha256": "a218cd22fc4871fc325642473999a222c886e0afed921ed66ed93e2529e29c33",
      "copy": [
        {
          "speaker": "Daro",
          "text": "I have the request. I still do not know the door."
        },
        {
          "speaker": "Sera",
          "text": "Then we look before we promise."
        }
      ]
    },
    {
      "id": "N8-03",
      "sha256": "ede01e19e87853d204f02d8dbe28359ef83eff263d3588f0ade9a3ecd332ee38",
      "copy": []
    },
    {
      "id": "N8-04",
      "sha256": "e07c8089c4b248914b2571a5399b115b2f9ffa23a1f2514d3eacec10bab4e10f",
      "copy": []
    },
    {
      "id": "N8-05",
      "sha256": "725681ec2cfeba7671bf252695bb8964d6855abf69a1cdf47a9d2415812a6434",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Stay on the dry side, please."
        }
      ]
    },
    {
      "id": "N8-06",
      "sha256": "ae42bc382f6c8d5ef627b6d4e35cadf8adb76ef07b7c6dc9cf8b26254fa48431",
      "copy": [
        {
          "speaker": "Daro",
          "text": "You asked about first-bell collection. This is Aren, and Sera came to see the approach."
        },
        {
          "speaker": "Edda",
          "text": "First bell is when this doorway is clear."
        }
      ]
    },
    {
      "id": "N8-07",
      "sha256": "a06f630a5e89fdc036bfdea02171e123bdc72456da248248c830db65594b79c8",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Second bell."
        },
        {
          "speaker": "Edda",
          "text": "The tubs keep moving through second bell. I cannot stop the wash floor for a cart."
        }
      ]
    },
    {
      "id": "N8-08",
      "sha256": "4c7c3557452860372bd5265e4b9910ccfcf87c2b408c69b56e15d11b371e54a1",
      "copy": [
        {
          "speaker": "Aren",
          "text": "First bell is my Lower Post round. I cannot take that time."
        }
      ]
    },
    {
      "id": "N8-09",
      "sha256": "9ac0a0e0ab89967a8cf0449ad45acf561d3b8eb91d07b3e1efe6d87da0babbdb",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Then why did you come?"
        },
        {
          "speaker": "Aren",
          "text": "Because we had not looked at the door."
        },
        {
          "speaker": "Edda",
          "text": "Good. Look before you quote me."
        }
      ]
    },
    {
      "id": "N8-10",
      "sha256": "e5290186d07ab824e73d05c159bf6be3725e8c467d45f5daf03a0050ece3eac9",
      "copy": [
        {
          "speaker": "Edda",
          "text": "These are ours. Two small bundles, dry and tied. We can try with them."
        }
      ]
    },
    {
      "id": "N8-11",
      "sha256": "3126b4b5e513a60d37430d43b0d1189c55167a733cc2962bee84f64634182180",
      "copy": [
        {
          "speaker": "Daro",
          "text": "The wheel stays out. That sill has a job."
        }
      ]
    },
    {
      "id": "N8-12",
      "sha256": "57d29c4c05859c9d5847d263ffa90670d22d4e7ec70b2467da69bed5a7de25e4",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I can carry one through by hand."
        },
        {
          "speaker": "Sera",
          "text": "We should see whether the doorway stays clear while you do."
        }
      ]
    },
    {
      "id": "N8-13",
      "sha256": "78d4396af6d4480582d9a4c0dfc39b6cb9247abd109a64c75d75ad498935981d",
      "copy": [
        {
          "speaker": "Edda",
          "text": "One out-and-back trial, as far as the trough. Both bundles come back to this bench."
        },
        {
          "speaker": "Edda",
          "text": "I will pay each of you for the trial, even if we stop at the door."
        }
      ]
    },
    {
      "id": "N8-14",
      "sha256": "d1902bc3f62699ce099c3653a8455fbe95e531d48c6195e9f0e2bab0d2d9d11a",
      "copy": [
        {
          "speaker": "Daro",
          "text": "I can do one trial now. The packing yard has me after third bell."
        },
        {
          "speaker": "Aren",
          "text": "If the route does not work, we bring it back."
        }
      ]
    },
    {
      "id": "N8-15",
      "sha256": "38c175dd1269f05864ba3d65f18eb0fa70648c378dbc7c31e2ec5093be51412b",
      "copy": [
        {
          "speaker": "Sera",
          "text": "Use the morning as it is. Do not clear it for us."
        }
      ]
    },
    {
      "id": "N8-16",
      "sha256": "501bc2cba221423965d086b8c18345e2a8abe12a4eb74edb42714c0a2fb46c4d",
      "copy": []
    },
    {
      "id": "N8-17",
      "sha256": "47f13eeb774e284918ff3c1562ea2ef7a35839f50aadc4288566733c33aee72a",
      "copy": []
    },
    {
      "id": "N8-18",
      "sha256": "5ad118ff3e2afa1b58f9cbbd601e2259c1e9639950a8acd025764a6ff36ef35b",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Wait. I am taking your doorway."
        }
      ]
    },
    {
      "id": "N8-19",
      "sha256": "84faec99c4c13dd3230e7347a0a2f156b4a749f93b9d6b29d643bad7792acaf9",
      "copy": []
    },
    {
      "id": "N8-20",
      "sha256": "0793a45a0606db3574675ec0dd356215fa714feb1ef6f9c09793c06856279f2c",
      "copy": [
        {
          "speaker": "Edda",
          "text": "That is what I meant by first bell."
        },
        {
          "speaker": "Aren",
          "text": "You needed the doorway back. Not an earlier cart."
        }
      ]
    },
    {
      "id": "N8-21",
      "sha256": "528bd512265d7dbda662c028e0a6a5d5992320e640c02d7e3c417af2b8fe1504",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Does that one open onto the dry bench?"
        }
      ]
    },
    {
      "id": "N8-22",
      "sha256": "e36883e2516e0e6020101ad045c68a2281dce29c8bf1413a30487727ffb0d7ce",
      "copy": [
        {
          "speaker": "Edda",
          "text": "We use it for mending. A collection basket will not fit."
        },
        {
          "speaker": "Daro",
          "text": "These wraps will. The cart stays out here."
        }
      ]
    },
    {
      "id": "N8-23",
      "sha256": "5845dce90ebff8e8fce63dc6f7c2dc4673ac25693e325c6435075971a3feb715",
      "copy": [
        {
          "speaker": "Edda",
          "text": "If the wash floor keeps moving, I do not need you at first bell."
        }
      ]
    },
    {
      "id": "N8-24",
      "sha256": "c87ae0a4b131d6655cc3e3fd87251762d23cd70cd9f3f24131d828d5ed5e15ee",
      "copy": []
    },
    {
      "id": "N8-25",
      "sha256": "fcecb8df61d8b5403d23398c678c78e2aa2ed9f3652b7bd429662f35da2b56fd",
      "copy": []
    },
    {
      "id": "N8-26",
      "sha256": "ed5dfa9c92d67988577d59a1a24bd94054266088baff96aa63733349bab8b3e5",
      "copy": []
    },
    {
      "id": "N8-27",
      "sha256": "ea3a62f3d8c030ccd167ba9107583896b58fb43f206a8124c21a42ad6ca5d622",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Beside the first. Keep the handle side clear."
        }
      ]
    },
    {
      "id": "N8-28",
      "sha256": "36c2052cbfbe85656f72a98e0723262472a28bfc33b541f7578d692c4e908611",
      "copy": []
    },
    {
      "id": "N8-29",
      "sha256": "2ddc54cb3edcf98201513f9b9af3b7d0e6e4161bfcae70d46456809d2652aad2",
      "copy": []
    },
    {
      "id": "N8-30",
      "sha256": "ada83f6b7e717bad033a38b97702b2297119f82be1316eac808283be213be6b1",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Enough room to stop and let someone past."
        }
      ]
    },
    {
      "id": "N8-31",
      "sha256": "b2abdd80769bef637f57e7dd761ed8de69fc28f4b721c1caa23d1d8f6fe26bf8",
      "copy": []
    },
    {
      "id": "N8-32",
      "sha256": "76a003b1755f70b47c98f1b14960ce507278c2c81579dd20c4452c5b51e8c085",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Dry. Both back. And the floor never stopped."
        }
      ]
    },
    {
      "id": "N8-33",
      "sha256": "50379cfa7bb396871c8517e5061fa882f273881756ec45e313ccf638236dcbab",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Use this hatch when we agree a collection. Do not leave a stack outside for me to find."
        }
      ]
    },
    {
      "id": "N8-34",
      "sha256": "a24f0806a30fd98bd74f6c34a7dc6787523f397a9d8a442c391b699d029fc270",
      "copy": [
        {
          "speaker": "Aren",
          "text": "After the post, between second and third bell. Only small, dry bundles like these."
        },
        {
          "speaker": "Edda",
          "text": "And I hand them over. Nothing waiting in the street."
        }
      ]
    },
    {
      "id": "N8-35",
      "sha256": "048c7dac20a74eb591786119f189ded72912f9300999db65fb6445501a601ac0",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Ask where the load is going before you put my cart in the plan."
        },
        {
          "speaker": "Aren",
          "text": "Door, load and your hours. Then a price."
        }
      ]
    },
    {
      "id": "N8-36",
      "sha256": "510244fc9c1fec1c43ce871a75b48db3eac060840972acdd1137ca04546b8a1d",
      "copy": [
        {
          "speaker": "Sera",
          "text": "Dry hatch. Two bundles. One forecourt trial."
        },
        {
          "speaker": "Sera",
          "text": "That is what we have seen."
        }
      ]
    },
    {
      "id": "N8-37",
      "sha256": "5a1c437653e75b26d30124badbf3a9a417d6a7c09dfe7a8a86db7b10d4e78a3c",
      "copy": [
        {
          "speaker": "Edda",
          "text": "For your time. The stopped attempt counted too."
        }
      ]
    },
    {
      "id": "N8-38",
      "sha256": "29fd8ef982aa857aaa5905de049f9b588406fb4f623db820bae8bb9c2e709874",
      "copy": [
        {
          "speaker": "Edda",
          "text": "And yours."
        }
      ]
    },
    {
      "id": "N8-39",
      "sha256": "4beb48d9ee843677e080e0ae69ab8fcc8315c568abeb60e4e2f5b759e72560c8",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Next time, knock here before you bring anything."
        },
        {
          "speaker": "Aren",
          "text": "We will ask about the load first."
        }
      ]
    },
    {
      "id": "N8-40",
      "sha256": "f69db73e634ea59d31f787958f884dcb119671bf4818da0d6a3d143dd0c6c49f",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I nearly said first bell just to keep her listening."
        },
        {
          "speaker": "Daro",
          "text": "She listened when you stopped guessing about her morning."
        }
      ]
    },
    {
      "id": "N8-41",
      "sha256": "001bc8b5e3ddfa25e2e913acff2367263d477505c0ca5df35bdef821306b2258",
      "copy": [
        {
          "speaker": "Daro",
          "text": "I have my next job. Ask me before you accept the next load."
        },
        {
          "speaker": "Aren",
          "text": "I will."
        }
      ]
    },
    {
      "id": "N8-42",
      "sha256": "d70a227c4ab7beb72c4208de705989de598b7b25ea1315d709212ff2a49ead3c",
      "copy": [
        {
          "speaker": "Sera",
          "text": "You stopped the first method before it stopped her work."
        },
        {
          "speaker": "Aren",
          "text": "I still want to take the route assessment I missed."
        }
      ]
    },
    {
      "id": "N8-43",
      "sha256": "87bd389647079de2657a6901a8d5760a90e4ca4bd9342e957408fff8f2263d3c",
      "copy": [
        {
          "speaker": "Sera",
          "text": "Ask for the hours and the load. I can say what I saw; the assessor decides what is tested."
        },
        {
          "speaker": "Aren",
          "text": "Tomorrow after the post. I ask before I commit."
        }
      ]
    },
    {
      "id": "N8-44",
      "sha256": "17a10a05b0c4c74ad5d5e09015351410221f4b29bac0cae488fcc6d06ea08231",
      "copy": []
    },
    {
      "id": "N8-45",
      "sha256": "3829d39f9b7be922871636d4bacdf599bc3b0a78eecd9a91c1bb88d54a59951d",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I want to know which part I am ready for."
        },
        {
          "speaker": "Sera",
          "text": "Then that is the question we take."
        }
      ]
    }
  ],
