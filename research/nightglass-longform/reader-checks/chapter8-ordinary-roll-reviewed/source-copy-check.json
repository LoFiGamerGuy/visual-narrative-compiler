      "copy": [
        {
          "speaker": "Daro",
          "text": "Beside the first. Keep the handle side clear."
        }
      ]
    },
    {
      "id": "N8-28",
      "sha256": "36c2052cbfbe85656f72a98e0723262472a28bfc33b541f7578d692c4e908611",
