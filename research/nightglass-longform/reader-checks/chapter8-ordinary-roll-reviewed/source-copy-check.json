  "source_copy_records": [
    {
      "id": "N8-01",
      "sha256": "7939fcbc2e56061e70ef5da9e9d0ec110ff1f04a35f09a13dcebb991f2409758",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Next morning. Tenth round complete."
        },
        {
          "speaker": "Ossa",
          "text": "They will still be there when you have put your money away."
        }
      ]
    },
    {
      "id": "N8-02",
      "sha256": "a218cd22fc4871fc325642473999a222c886e0afed921ed66ed93e2529e29c33",
      "copy": [
        {
          "speaker": "Daro",
          "text": "I have the request. I still do not know the door."
        },
        {
          "speaker": "Sera",
          "text": "Then we look before we promise."
        }
      ]
    },
    {
      "id": "N8-03",
      "sha256": "ede01e19e87853d204f02d8dbe28359ef83eff263d3588f0ade9a3ecd332ee38",
      "copy": []
    },
    {
      "id": "N8-04",
      "sha256": "e07c8089c4b248914b2571a5399b115b2f9ffa23a1f2514d3eacec10bab4e10f",
      "copy": []
    },
    {
      "id": "N8-05",
      "sha256": "725681ec2cfeba7671bf252695bb8964d6855abf69a1cdf47a9d2415812a6434",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Stay on the dry side, please."
        }
      ]
    },
    {
      "id": "N8-06",
      "sha256": "ae42bc382f6c8d5ef627b6d4e35cadf8adb76ef07b7c6dc9cf8b26254fa48431",
      "copy": [
        {
          "speaker": "Daro",
          "text": "You asked about first-bell collection. This is Aren, and Sera came to see the approach."
        },
        {
          "speaker": "Edda",
          "text": "First bell is when this doorway is clear."
        }
      ]
    },
    {
      "id": "N8-07",
      "sha256": "a06f630a5e89fdc036bfdea02171e123bdc72456da248248c830db65594b79c8",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Second bell."
        },
        {
          "speaker": "Edda",
          "text": "The tubs keep moving through second bell. I cannot stop the wash floor for a cart."
        }
      ]
    },
    {
      "id": "N8-08",
      "sha256": "4c7c3557452860372bd5265e4b9910ccfcf87c2b408c69b56e15d11b371e54a1",
      "copy": [
        {
          "speaker": "Aren",
          "text": "First bell is my Lower Post round. I cannot take that time."
        }
      ]
    },
    {
      "id": "N8-09",
      "sha256": "9ac0a0e0ab89967a8cf0449ad45acf561d3b8eb91d07b3e1efe6d87da0babbdb",
      "copy": [
        {
          "speaker": "Edda",
          "text": "Then why did you come?"
        },
        {
          "speaker": "Aren",
          "text": "Because we had not looked at the door."
        },
        {
          "speaker": "Edda",
          "text": "Good. Look before you quote me."
        }
      ]
    },
    {
      "id": "N8-10",
      "sha256": "e5290186d07ab824e73d05c159bf6be3725e8c467d45f5daf03a0050ece3eac9",
      "copy": [
        {
          "speaker": "Edda",
          "text": "These are ours. Two small bundles, dry and tied. We can try with them."
        }
      ]
    },
    {
      "id": "N8-11",
      "sha256": "3126b4b5e513a60d37430d43b0d1189c55167a733cc2962bee84f64634182180",
      "copy": [
        {
          "speaker": "Daro",
          "text": "The wheel stays out. That sill has a job."
        }
      ]
    },
    {
      "id": "N8-12",
      "sha256": "57d29c4c05859c9d5847d263ffa90670d22d4e7ec70b2467da69bed5a7de25e4",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I can carry one through by hand."
        },
        {
          "speaker": "Sera",
          "text": "We should see whether the doorway stays clear while you do."
        }
      ]
    },
    {
      "id": "N8-13",
      "sha256": "78d4396af6d4480582d9a4c0dfc39b6cb9247abd109a64c75d75ad498935981d",
      "copy": [
        {
          "speaker": "Edda",
          "text": "One out-and-back trial, as far as the trough. Both bundles come back to this bench."
        },
        {
          "speaker": "Edda",
          "text": "I will pay each of you for the trial, even if we stop at the door."
        }
      ]
    },
    {
      "id": "N8-14",
      "sha256": "d1902bc3f62699ce099c3653a8455fbe95e531d48c6195e9f0e2bab0d2d9d11a",
      "copy": [
        {
          "speaker": "Daro",
          "text": "I can do one trial now. The packing yard has me after third bell."
        },
        {
          "speaker": "Aren",
          "text": "If the route does not work, we bring it back."
        }
      ]
    },
    {
      "id": "N8-15",
      "sha256": "38c175dd1269f05864ba3d65f18eb0fa70648c378dbc7c31e2ec5093be51412b",
      "copy": [
        {
          "speaker": "Sera",
          "text": "Use the morning as it is. Do not clear it for us."
        }
      ]
    },
    {
      "id": "N8-16",
      "sha256": "501bc2cba221423965d086b8c18345e2a8abe12a4eb74edb42714c0a2fb46c4d",
      "copy": []
    },
    {
      "id": "N8-17",
      "sha256": "47f13eeb774e284918ff3c1562ea2ef7a35839f50aadc4288566733c33aee72a",
      "copy": []
    },
    {
      "id": "N8-18",
      "sha256": "5ad118ff3e2afa1b58f9cbbd601e2259c1e9639950a8acd025764a6ff36ef35b",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Wait. I am taking your doorway."
        }
      ]
    },
    {
      "id": "N8-19",
      "sha256": "84faec99c4c13dd3230e7347a0a2f156b4a749f93b9d6b29d643bad7792acaf9",
      "copy": []
    },
    {
      "id": "N8-20",
      "sha256": "0793a45a0606db3574675ec0dd356215fa714feb1ef6f9c09793c06856279f2c",
      "copy": [
        {
          "speaker": "Edda",
          "text": "That is what I meant by first bell."
        },
        {
          "speaker": "Aren",
          "text": "You needed the doorway back. Not an earlier cart."
        }
      ]
    },
    {
      "id": "N8-21",
      "sha256": "528bd512265d7dbda662c028e0a6a5d5992320e640c02d7e3c417af2b8fe1504",
      "copy": [
        {
          "speaker": "Daro",
          "text": "Does that one open onto the dry bench?"
        }
      ]
    },
    {
      "id": "N8-22",
      "sha256": "e36883e2516e0e6020101ad045c68a2281dce29c8bf1413a30487727ffb0d7ce",
      "copy": [
        {
          "speaker": "Edda",
          "text": "We use it for mending. A collection basket will not fit."
        },
        {
          "speaker": "Daro",
          "text": "These wraps will. The cart stays out here."
        }
      ]
    },
    {
      "id": "N8-23",
      "sha256": "5845dce90ebff8e8fce63dc6f7c2dc4673ac25693e325c6435075971a3feb715",
      "copy": [
        {
          "speaker": "Edda",
          "text": "If the wash floor keeps moving, I do not need you at first bell."
        }
      ]
    },
    {
      "id": "N8-24",
      "sha256": "c87ae0a4b131d6655cc3e3fd87251762d23cd70cd9f3f24131d828d5ed5e15ee",
      "copy": []
