      "copy": []
    },
    {
      "id": "N9-33",
      "sha256": "c81f7957e24ab1b6bb3ef4cbbe4fc405c6e0a7693a3853afa9320992d98cd434",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I have looked at these windows from below."
        },
        {
          "speaker": "Neris",
          "text": "They leak from this side too."
        }
      ]
    },
    {
      "id": "N9-34",
      "sha256": "54cb51f736dd973eb873afd991d8c95895495777d2c2d5d7e526ef7df8ca2342",
      "copy": [
        {
          "speaker": "Clerk",
          "text": "The intake letter? Here, please."
        }
      ]
    },
    {
      "id": "N9-35",
      "sha256": "87d11d2170406eefd67cda9daf6a5b1355639cab1676233b5c800a527c07be7a",
      "copy": []
    },
    {
      "id": "N9-36",
      "sha256": "f7906cb43a388b9d9bca6bdf42e13dc932c213759fb3ab33f5325462b22ed420",
      "copy": [
        {
          "speaker": "Clerk",
          "text": "West desk. Received."
        },
        {
          "speaker": "Neris",
          "text": "That is the whole carry."
        }
      ]
    },
    {
      "id": "N9-37",
      "sha256": "7ae6be6c9df5d362d332eb5671308d28e3ea99632c63753d97bf1b0b23946f30",
      "copy": [
        {
          "speaker": "Clerk",
          "text": "Three coppers, as agreed."
        }
      ]
    },
    {
      "id": "N9-38",
      "sha256": "0383a1f9f2181930e68ed02c1f0003d1b0d3f900ffac29d433e964505ebaa84e",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I want to remember this."
        },
        {
          "speaker": "Sera",
          "text": "Then take a moment."
        }
      ]
    },
    {
      "id": "N9-39",
      "sha256": "99512f65cbc38769c62201e6acc12dc4de1d7b8c0186ebd01c2e2ba2ebeb5e6a",
      "copy": [
        {
          "speaker": "Neris",
          "text": "I have two more desks. You are finished for today."
        }
      ]
    },
    {
      "id": "N9-40",
      "sha256": "eaf882a78b876da920fb1979f9314c99de1b2c26136bf609529b6f8f3d6ceb2a",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I would like another assignment."
        },
        {
          "speaker": "Neris",
          "text": "Bring your available hours next time. We will see what needs doing."
        }
      ]
    },
    {
      "id": "N9-41",
      "sha256": "f6232806f5ca8a5848877beae8278c1d6ed195e1eae3ef7d5906f538329f560d",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I still have time before supper."
        },
        {
          "speaker": "Sera",
          "text": "Shall we walk?"
        }
      ]
    },
