  "source_copy_records": [
    {
      "id": "N9-01",
      "sha256": "7c5cc8171251cc6e9b527f9ab00bf4eefd8a356ad6d0e3fda230b767d0320ae2",
      "copy": [
        {
          "speaker": "Caption",
          "text": "Eleventh round complete."
        },
        {
          "speaker": "Ossa",
          "text": "Good luck, Aren."
        }
      ]
    },
    {
      "id": "N9-02",
      "sha256": "ad6297440de0d185a94b1a969fdd4db3ef0679f22b94ece194b4663447fd4c30",
      "copy": []
    },
    {
      "id": "N9-03",
      "sha256": "5da4ca1124f59d2286986d17c8bdb512e94fd19b8ebd8f38694249d72c119b65",
      "copy": [
        {
          "speaker": "Neris",
          "text": "I am Neris. I assess controlled transfers and supervise today’s upper couriers."
        }
      ]
    },
    {
      "id": "N9-04",
      "sha256": "ff7b27c78c541434375d78a3a952bbadb7ae6dae0ff13182dc872d59847079fb",
      "copy": [
        {
          "speaker": "Neris",
          "text": "No fee. One bell of your time. A pass qualifies you for supervised light-transfer work."
        },
        {
          "speaker": "Aren",
          "text": "I have one bell."
        }
      ]
    },
    {
      "id": "N9-05",
      "sha256": "40038434889b0568ff87657c8bbe0d07d4a05ce8a07413558e735920fd1fbd45",
      "copy": [
        {
          "speaker": "Neris",
          "text": "Stay inside the blue mark. Wait for his invitation before the handover."
        }
      ]
    },
    {
      "id": "N9-06",
      "sha256": "2fbb51298e8bbe35a3a7c50b51cc1cec6b4b7273972d9676d061823b58f39e6e",
      "copy": [
        {
          "speaker": "Neris",
          "text": "A light wooden practice weight. No customer mail."
        },
        {
          "speaker": "Neris",
          "text": "If your footing, line or landing is wrong, do not launch. Call a reset."
        }
      ]
    },
    {
      "id": "N9-07",
      "sha256": "6e47bab1e9e74468a707829b4daab27d2589439c3f1507d917293ef6571f078c",
      "copy": []
    },
    {
      "id": "N9-08",
      "sha256": "06153c007bae077e56067c8ab835f4099b6cbbaf67d61df46bd1f780a05c33f8",
      "copy": []
    },
    {
      "id": "N9-09",
      "sha256": "42a2f238b3766538994126941db3fa9ba95c080584e5ba9271329b317755c826",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I kept thinking I would have to make it look easy."
        }
      ]
    },
    {
      "id": "N9-10",
      "sha256": "c0b57ade94d999fedd86764bf9c0db20e0398c5ebcaf77ffb7fb24d1d25c90b4",
      "copy": [
        {
          "speaker": "Neris",
          "text": "I need someone I can keep working beside. Show me that."
        }
      ]
    },
    {
      "id": "N9-11",
      "sha256": "978635819bb199e5413ad0b0ff0367c32934f1a0d21d683f6eaf0fa88bc2075b",
      "copy": []
    },
    {
