    {
      "id": "N9-17",
      "sha256": "0754799cbd187e8b3717b66cf909e5e03689c77323110dcbcde8e555d45bdebe",
      "copy": [
        {
          "speaker": "Attendant",
          "text": "One moment."
        }
      ]
    },
    {
      "id": "N9-18",
      "sha256": "a06e69ba1cc7091010bda1ff18fb372dbcc2bbc1bcf9a3a2f8464356ed5c992a",
      "copy": []
    },
    {
      "id": "N9-19",
      "sha256": "4036927ed0ab97a856a12d187afe7f57950d064147581459d51452c3981cdbbb",
      "copy": [
        {
          "speaker": "Attendant",
          "text": "Here. I can take it now."
        }
      ]
    },
    {
      "id": "N9-20",
      "sha256": "b5acc1f8f1d2d1a8965b2b403168b02a332fa4bd5bb9eb51602b6c90a10f56f0",
      "copy": []
    },
    {
      "id": "N9-21",
      "sha256": "25525049a239d248c78eaaa7c57f55fee5c6f6334f55a755e76d0631758f5d12",
      "copy": []
    },
    {
      "id": "N9-22",
      "sha256": "4f86c04fa7fd00df5391bd401cd4c8c5e518f98bb8c6683b4115faf8083d1ce7",
      "copy": [
        {
          "speaker": "Neris",
          "text": "You stopped inside the mark. Then you left him time to finish."
        }
      ]
    },
    {
      "id": "N9-23",
      "sha256": "542df351724517e1ef8efcfd9d530db4f2c907fd2ab942d0f3dcd5cb9a838416",
      "copy": [
        {
          "speaker": "Aren",
          "text": "Was that enough?"
        },
        {
          "speaker": "Neris",
          "text": "For the work we tested. You passed."
        }
      ]
    },
    {
      "id": "N9-24",
      "sha256": "d5f6e0dc84314e33512716456845cb03280f49eeb314ca3d9e5f3b430c457b6e",
      "copy": [
        {
          "speaker": "Neris",
          "text": "Controlled transfer. Supervised light work. It is entered."
        }
      ]
    },
    {
      "id": "N9-25",
      "sha256": "9abeb220ec306abf5f432d60bc1438728582150129eaace3af5e449f70e38a90",
      "copy": [
        {
          "speaker": "Neris",
          "text": "I can authorize one carry with me now. It is optional."
        }
      ]
    },
    {
      "id": "N9-26",
      "sha256": "9fda0271ef728030be724d2d5b231caf60001f504b75c3e2298fbb4506ce9372",
      "copy": [
        {
          "speaker": "Neris",
          "text": "West sorting desk, by the corridor with me. One letter, another quarter bell."
        },
        {
          "speaker": "Neris",
          "text": "Three coppers for this carry, paid at West desk."
        }
      ]
    },
    {
      "id": "N9-27",
      "sha256": "603c2fca3157e740b493333983fea990904150c956f8a52fbc7d39b3b22ffe9c",
      "copy": [
        {
          "speaker": "Aren",
          "text": "I have the quarter bell. I will take that one."
        }
      ]
    },
    {
      "id": "N9-28",
      "sha256": "e7f1b059e7aedae17488b237b6ef74153d8b7431dbfec07544401e34654faca0",
      "copy": []
    },
    {
      "id": "N9-29",
      "sha256": "b45be189b1f48e873044b9aa6a77df2eaa8c4fb010d3a9511ad158dacaa37f25",
      "copy": []
    },
    {
      "id": "N9-30",
      "sha256": "a89cf01fbdd75d4fa0634eb02b262a9b6c0a146fd98498cba9e67f89200ba342",
      "copy": [
        {
          "speaker": "Neris",
          "text": "Aren is cleared for this assignment, under my supervision. West desk."
        }
      ]
    },
    {
      "id": "N9-31",
      "sha256": "4300a6b3539e8e004c89116ab53b18ea4455f6f20c1769fb26df19f5dc0d70ee",
      "copy": []
    },
    {
